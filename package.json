{
  "name": "focusbae-electron",
  "version": "1.3.3",
  "description": "FocusBae — local-first notes, meetings, and actions on your Mac",
  "author": "Prateek Saxena",
  "main": "local-first-main.js",
  "scripts": {
    "start": "npm run build:workspace && electron .",
    "icons:generate": "node scripts/generate-brand-icons.cjs",
    "build:workspace": "npm run build:embedding && npm run build:extract && npm run build:fluid && npm run build:speech && vite build --config desktop-ui/vite.config.mjs",
    "test:workspace": "node --test tests/workspace-shell/*.test.js",
    "test:recording": "node --test tests/recording/*.test.js",
    "test:models": "node --test tests/models/*.test.js",
    "test:release": "node --test tests/release/*.test.js",
    "test:local:e2e": "npm run build:workspace && node tests/workspace-shell/run-electron.cjs && node tests/workspace-shell/attachments-e2e.cjs",
    "verify:local:package": "npm run build:workspace && node scripts/package-workspace-probe.cjs && node tests/workspace-shell/run-electron.cjs --packaged && node tests/workspace-shell/attachments-e2e.cjs --packaged",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build:workspace && electron-builder --config scripts/release-candidate.config.cjs --mac --publish never",
    "test": "npm run test:capture && npm run test:local && npm run test:workspace && npm run test:recording && npm run test:models",
    "test:privacy": "node tests/privacy/run-electron.cjs",
    "test:local:network": "node tests/privacy/run-electron.cjs",
    "test:local": "node --test tests/local-first/*.test.js",
    "test:local:recovery": "node --test tests/local-first/recovery.test.js",
    "test:capture": "node meeting-capture/segmenter.test.js",
    "build:speech": "bash meeting-capture/apple-speech/build.sh",
    "build:embedding": "bash local-ai/apple-embedding/build.sh",
    "qualify:extraction": "node qualification/extraction/score.js",
    "build:extract": "bash local-ai/apple-extract/build.sh",
    "build:fluid": "bash local-ai/fluid-helpers/build.sh"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "5.3.0",
    "htmlparser2": "10.0.0",
    "markdown-it": "14.3.1",
    "sanitize-html": "2.17.7",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "electron-rebuild": "^3.2.9",
    "lucide-react": "0.577.0",
    "playwright": "1.58.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.3.0"
  },
  "build": {
    "icon": "build/icons/icon",
    "appId": "com.focusbae.app",
    "productName": "FocusBae",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!out/**/*",
      "!test-results/**/*",
      "!docs/**/*",
      "!**/.env*",
      "!**/*.p12",
      "!**/*.p8",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.keychain*",
      "!qualification/**/*",
      "!tests/**/*",
      "!scripts/*probe*.cjs",
      "!desktop-ui/src/**/*",
      "!desktop-ui/index.html",
      "!desktop-ui/vite.config.mjs",
      "!local-ai/fluid-helpers/.build/**/*",
      "!local-ai/*/Sources/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/audiotee/**",
      "**/node_modules/sqlite-vec/**",
      "**/node_modules/sqlite-vec-*/**",
      "**/meeting-capture/bin/**",
      "**/local-ai/bin/**"
    ],
    "afterPack": "./scripts/cleanup-signatures.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-f1d20a395b224af7aff8e7b531dbfdae.r2.dev/"
      }
    ],
    "dmg": {
      "artifactName": "FocusBae-${version}.dmg",
      "title": "FocusBae ${version}",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": "1",
        "NSAppleEventsUsageDescription": "Import your notes from Apple Notes into your private FocusBae workspace when you choose Import from Apple Notes in Settings.",
        "NSMicrophoneUsageDescription": "Record your voice into your local workspace when you choose to record.",
        "NSAudioCaptureUsageDescription": "Record system audio into your local workspace when you choose to record."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.local.mac.plist",
      "entitlementsInherit": "build/entitlements.local.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "optionalDependencies": {
    "audiotee": "^0.0.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prateek-Vortex/focusbae.git"
  },
  "homepage": "https://www.focusbae.com"
}
